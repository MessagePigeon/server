# Server port
PORT=3000

# PostgreSQL URL (async driver). For local dev the DB is exposed on localhost:5433
# (5433 avoids clashing with a host Postgres on 5432).
# In Docker, docker-compose overrides this to point at the `postgres` service.
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5433/pigeon"

# Any string is OK
JWT_SECRET="secret"

# Browser remember login time
# Format: https://github.com/vercel/ms
JWT_EXPIRES_IN="1 weeks"

# Admin login password
ADMIN_PASSWORD="password"

# Teacher website url (to generate connectable QR codes for students)
TEACHER_URL="https://example.mpigoen.xyz"
